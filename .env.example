# Copy to .env.local for direct Python launch, or to .env for Docker Compose.
# `jericho init` generates strong API and bridge secrets automatically.
FRIDAY_HOME=D:\jericho
FRIDAY_HOST_HOME=D:/jericho
FRIDAY_PROFILE=qwen36-27b-nvfp4-nvidia
FRIDAY_MODEL_ROOT=D:\jericho\models

# `jericho up` copy-truncates a child log past this size, keeping N generations.
# The bridge polls the backend every 15s and each poll costs an access-log line,
# so an unrotated backend.log grows by tens of megabytes a day. 0 = never rotate.
FRIDAY_LOG_MAX_BYTES=16777216
FRIDAY_LOG_BACKUPS=3

# Local OpenAI-compatible vLLM endpoint
FRIDAY_LLM_BASE_URL=http://127.0.0.1:8001/v1
# Container-to-container endpoint used by Docker Compose.
FRIDAY_DOCKER_LLM_BASE_URL=http://dispatcher:8001/v1
FRIDAY_LLM_MODEL=dispatcher
FRIDAY_LLM_ENABLED=1
FRIDAY_LLM_TIMEOUT_SEC=240
FRIDAY_LLM_MAX_TOKENS=2048

# Owner-only engineering workbench. Disabled by default. Docker on supported
# Ubuntu hosts must use deploy/engineer-mode/compose.override.yml and its loaded
# AppArmor profile; enabling without the real boundary smoke fails closed.
FRIDAY_ENGINEER_MODE_ENABLED=0

# Optional Ubuntu Host Capability Plane. All switches are independently
# default-off. Use deploy/host-control/compose.override.yml after running its
# local installer; never mount host executables, /home, /etc or Docker's socket.
# The installer prints these seven host-only Compose interpolation values.  The
# optional override refuses to render while any is empty; do not guess IDs.
FRIDAY_HOST_RUNTIME_UID=
FRIDAY_HOST_RUNTIME_GID=
FRIDAY_HOST_AGENT_SOCKET_DIR_HOST=
FRIDAY_HOST_AGENT_KEY_FILE_HOST=
FRIDAY_HOST_APPROVAL_SIGNING_KEY_FILE_HOST=
FRIDAY_HOST_APPROVAL_SIGNER_GID=
FRIDAY_HOST_JOB_DATA_DIR_HOST=
FRIDAY_HOST_CONTROL_ENABLED=0
FRIDAY_HOST_AGENT_SOCKET=/run/friday-host-agent/agent.sock
FRIDAY_HOST_AGENT_KEY_FILE=/run/secrets/friday_host_agent_hmac
FRIDAY_HOST_APPROVAL_SIGNING_KEY_FILE=/run/friday-backend-approval.key
FRIDAY_HOST_JOB_ROOT=/runtime/data/host-control/jobs
FRIDAY_HOST_ACTION_MAX_CONCURRENCY=2
FRIDAY_HOST_ACTION_DEFAULT_TIMEOUT_SEC=300
FRIDAY_HOST_ACTION_MAX_OUTPUT_BYTES=8388608
FRIDAY_HOST_PACKAGE_INSTALL_ENABLED=0
# Reserved/unsupported in this release; startup requires both to remain 0.
FRIDAY_HOST_DESKTOP_CONTROL_ENABLED=0
FRIDAY_HOST_ONE_SHOT_EXEC_ENABLED=0
# Shared exact target policy for Host Control and Engineer active assessment.
# Except exact loopback, Engineer needs an admitted CIDR. Public scope also
# needs this flag and a separate per-action approval; Engineer v1 has no public
# HITL carrier and therefore still refuses public probes.
FRIDAY_HOST_PUBLIC_NETWORK_ENABLED=0
FRIDAY_HOST_ALLOWED_CIDRS=
FRIDAY_HOST_ALLOWED_PATH_ROOTS=

# Optional text-only advisory node. It never replaces the primary model and is
# inert unless both ENABLED and a non-disabled MODE are set. Use the private-CA
# HTTPS gateway from deploy/secondary-brain/windows-sglang; one flag rolls back.
FRIDAY_SECONDARY_LLM_ENABLED=0
FRIDAY_SECONDARY_LLM_MODE=disabled
FRIDAY_SECONDARY_LLM_BASE_URL=
# Exact digest-derived alias from the accepted code-owned profile.
FRIDAY_SECONDARY_LLM_MODEL=
FRIDAY_SECONDARY_LLM_API_KEY=
# In the primary Docker runtime, copy the public laptop CA under the existing
# host data mount and use /runtime/data/secondary-brain/ca.crt here.
FRIDAY_SECONDARY_LLM_CA_FILE=
FRIDAY_SECONDARY_LLM_CONNECT_TIMEOUT_SEC=1.0
FRIDAY_SECONDARY_LLM_READ_TIMEOUT_SEC=12.0
FRIDAY_SECONDARY_LLM_CALL_BUDGET_SEC=15.0
FRIDAY_SECONDARY_LLM_ADMISSION_TIMEOUT_SEC=0.10
FRIDAY_SECONDARY_LLM_HEALTH_INTERVAL_SEC=30
FRIDAY_SECONDARY_LLM_COOLDOWN_SEC=60
# Set only to the largest context which passed cold-start and soak certification.
FRIDAY_SECONDARY_LLM_MAX_CONTEXT_TOKENS=0
FRIDAY_SECONDARY_LLM_MAX_CONCURRENCY=1
# Exact code-owned profile ID published only after live node certification.
FRIDAY_SECONDARY_LLM_PROFILE=
FRIDAY_SECONDARY_LLM_WORKLOADS=extract
FRIDAY_SECONDARY_LLM_ALLOW_PRIVATE_TEXT=0
# Independent rollout gate for bounded document-map leaves. Current exact v1
# policy admits only discarded shadow; assist needs a later evidence-bound gate.
FRIDAY_SECONDARY_LLM_DOCUMENT_MAP_MODE=disabled
# Reversible V12 rollout. `legacy` preserves the current runtime exactly;
# shadow plans without a second answer/effect; canary/v12 remain route-allowlisted.
FRIDAY_ROUTER_MODE=legacy
FRIDAY_ROUTER_CANARY_ROUTES=file_read
# Empty means no user is in canary. `owner` admits only the canonical owner.
FRIDAY_ROUTER_CANARY_USER_IDS=
FRIDAY_ROUTER_PLAN_TIMEOUT_SEC=12
# Turning this on WITHOUT a model name below disables dense recall entirely;
# startup validation refuses that combination rather than reporting it as working.
FRIDAY_EMBEDDINGS_ENABLED=0
FRIDAY_EMBEDDINGS_BASE_URL=http://127.0.0.1:8001/v1
FRIDAY_DOCKER_EMBEDDINGS_BASE_URL=http://dispatcher:8001/v1
FRIDAY_EMBEDDINGS_MODEL=
# Passage-level recall for long objects (0 = off, pre-0.41 behaviour).
FRIDAY_EMBEDDINGS_CHUNK_CHARS=1200
FRIDAY_EMBEDDINGS_CHUNK_OVERLAP_CHARS=200
# Ceiling on the lexical recall pool per search. Beyond it the fuzzy channel sees
# only the most important/recent slice, and the answer reports
# `strategy.lexical_pool_capped` with the real corpus size.
FRIDAY_RETRIEVAL_POOL_MAX=400
# Cosine below which a dense score is not evidence (the `insufficient_evidence`
# filter). This number belongs to the embedding MODEL: measured on
# qwen3-embedding-0.6b, unrelated query/document pairs peak at 0.39 and genuine
# matches start at 0.42. Re-measure when you change models.
FRIDAY_RETRIEVAL_DENSE_EVIDENCE_MIN=0.35

# How many verified backups to keep locally. The schedule adds a full copy of the
# database every 24 hours; without a ceiling the disk fills and takes the live
# instance with it. Pruning runs after mirroring. 0 = keep everything.
FRIDAY_BACKUP_KEEP=14

# Full-content Markdown is a secondary plaintext projection, so it is disabled
# unless the owner opts in explicitly. Exact values: disabled | full_owner.
# Disabling never deletes an existing legacy projection; `jericho doctor` reports
# only its count. Ordinary offline purge still removes the one note bound to a KO
# that is actually being purged; it is not a bulk vault-cleanup command.
FRIDAY_MEMORY_VAULT_MODE=disabled

# Free Android Obsidian integration (Linux beta). The Compose backend contains
# the reviewed Syncthing v2.1.3 binary; direct installs must provide an absolute
# executable path. The server accepts inbound sync through Syncthing relays and
# may initiate a direct connection discovered through global discovery:
# no Obsidian account, paid Sync, desktop or QR is required.
FRIDAY_OBSIDIAN_ENABLED=0
FRIDAY_OBSIDIAN_ROOT=
FRIDAY_OBSIDIAN_VAULT_NAME=Friday
FRIDAY_SYNCTHING_BINARY=/usr/local/bin/syncthing
FRIDAY_SYNCTHING_MIN_VERSION=2.1.3
FRIDAY_SYNCTHING_MAX_VERSION=2.2.0
FRIDAY_OBSIDIAN_PAIRING_TTL_SEC=900
FRIDAY_OBSIDIAN_MAX_PROFILES=64
FRIDAY_OBSIDIAN_TRANSPORT_MODE=discovery_relay
FRIDAY_OBSIDIAN_PUBLIC_SETUP_RATE_LIMIT_PER_MINUTE=10
# Browser-facing HTTPS origin used by the Telegram fallback guide, without a
# trailing slash. Required when the integration is enabled.
FRIDAY_PUBLIC_BASE_URL=
FRIDAY_OBSIDIAN_RECONCILE_INTERVAL_SEC=10
FRIDAY_OBSIDIAN_REST_TIMEOUT_SEC=5

# API and Admin UI
FRIDAY_API_HOST=127.0.0.1
FRIDAY_API_BIND_ADDRESS=127.0.0.1
FRIDAY_API_PORT=8000
FRIDAY_API_TOKEN=replace-with-at-least-32-random-characters
FRIDAY_API_REQUIRE_TOKEN_ON_LOOPBACK=1
FRIDAY_API_USER_RATE_LIMIT_PER_MINUTE=240
# Native TLS for a direct/systemd installation: set both server paths or neither.
# Base Compose intentionally overrides these to empty and expects an external TLS
# reverse proxy, so its Telegram container never receives the private key.
# Bridge and diagnostics add only the public CA/certificate to their verified
# default trust stores; the private key never belongs in a client trust store.
FRIDAY_SSL_CERTFILE=
FRIDAY_SSL_KEYFILE=
FRIDAY_BACKEND_CA_FILE=
# Empty derives exact loopback origins using the configured HTTP/HTTPS scheme and
# API port. For LAN Admin UI, list every exact browser-facing HTTPS origin.
FRIDAY_CORS_ORIGINS=
FRIDAY_TRUST_PROXY_HEADERS=0
# Required only when proxy headers are enabled; list the immediate trusted proxy hops.
FRIDAY_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128

# Telegram bridge
FRIDAY_TELEGRAM_BOT_TOKEN=
FRIDAY_TELEGRAM_BRIDGE_SECRET=replace-with-a-different-32-character-random-secret
FRIDAY_TELEGRAM_REALM_ID=telegram
# Deny-by-default: the bot ignores every chat until an allowlist or owner chat
# is set. The effective allowlist is the union of the two lists below.
#
# At least one PRIVATE chat (a positive id) must be present. Group ids are
# negative, and the bridge signs its own service calls as a user — with only
# groups allowlisted it has nobody to sign as, and proactive delivery stops. The
# bridge says so in the log rather than going quiet.
FRIDAY_TELEGRAM_ALLOWED_CHAT_IDS=
FRIDAY_TELEGRAM_OWNER_CHAT_IDS=
# Proxy for reaching api.telegram.org, e.g. http://127.0.0.1:10808. Set this where
# Telegram needs a tunnel: the bridge then asks for the tunnel by name instead of
# depending on one that rewrites the host's routing table. Applies to Telegram only —
# the bridge always reaches its own backend directly. http:// or https:// only; SOCKS
# would need httpx's optional socksio package, and a mixed proxy accepts HTTP CONNECT
# on the same port anyway.
FRIDAY_TELEGRAM_PROXY=
FRIDAY_TELEGRAM_SIGNATURE_MAX_AGE_SEC=90
# Подпись под сочетанием «открытая регистрация + широкий пресет или общий
# архив». Такое сочетание отдаёт архив человеку, которого вы не называли по
# идентификатору, поэтому без этой строки система откажется подняться —
# попасть туда случайно, переключив один флаг, нельзя. С ней режим работает
# и остаётся громким: оба предупреждения видны в `jericho doctor`.
FRIDAY_OPEN_REGISTRATION_GRANTS_FULL_ACCESS=0
FRIDAY_TELEGRAM_USER_RATE_LIMIT_PER_MINUTE=30
FRIDAY_TELEGRAM_GLOBAL_RATE_LIMIT_PER_MINUTE=1200

# Local workers and safety limits
FRIDAY_WORKERS_ENABLED=1
FRIDAY_AUTONOMY_ENABLED=1
FRIDAY_OPERATOR_FULL_AUTONOMY=0
FRIDAY_COGNITION_ENABLED=1
FRIDAY_COGNITION_INTERVAL_SEC=300
FRIDAY_COGNITION_MAX_TOKENS=512
FRIDAY_EXECUTIVE_MAX_ACTIVE_MISSIONS=8
FRIDAY_EXECUTIVE_MAX_TASKS_PER_MISSION=12
FRIDAY_EXECUTIVE_TASK_TOOL_BUDGET=6
FRIDAY_EXECUTIVE_TICK_INTERVAL_SEC=15
FRIDAY_CODE_EXECUTION_ENABLED=0
FRIDAY_CODE_EXECUTION_TIMEOUT_SEC=15
FRIDAY_CODE_EXECUTION_MAX_OUTPUT_BYTES=65536
# Optional local MCP exchange. Friday can list/read its inbox and atomically
# create NEW UTF-8 text files in a separate outbox. There is no MCP operation
# for overwrite, append, move, delete, shell, SQLite or network access.
FRIDAY_MCP_ENABLED=0
# Empty values use <FRIDAY_HOME>/mcp-exchange/{inbox,outbox}.
FRIDAY_MCP_WORKSPACE_INBOX_DIR=
FRIDAY_MCP_WORKSPACE_OUTBOX_DIR=
FRIDAY_MCP_STARTUP_TIMEOUT_SEC=15
FRIDAY_MCP_CALL_TIMEOUT_SEC=20
FRIDAY_MCP_RESULT_CHARS=7000
FRIDAY_WEB_ALLOW_PRIVATE_NETWORKS=0
FRIDAY_WEB_MAX_RESPONSE_BYTES=5242880
FRIDAY_MAX_UPLOAD_BYTES=52428800
FRIDAY_MAX_EXTRACTED_TEXT_CHARS=2000000
# Сколько секунд разбирать PDF, после чего вернуть прочитанное с пометкой
# «неполно». Одна ручка на приём файла и на /api/ingest/url. Замерено: файл в
# 41 КБ с дорогими страницами занимал поток на 35 с без этого срока.
FRIDAY_PDF_PARSE_BUDGET_SEC=8.0
FRIDAY_MAX_ARCHIVE_ENTRIES=500
FRIDAY_MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000

# Что попадает в Inbox, прежде чем стать каноническим знанием.
#   unless_explicit — безопасное умолчание: прямо продвигается только явное
#                     сохранение (/note, «запомни»); всё остальное, включая файлы,
#                     ждёт человека
#   assessed        — явный режим совместимости: `promote` канонизируется сразу
#   always          — не продвигается ничто
# Массовый импорт, /api/ingest/url и импортёр ждут решения при любой политике.
FRIDAY_INGESTION_REVIEW_POLICY=unless_explicit

# Optional public-search providers
FRIDAY_BRAVE_SEARCH_API_KEY=
FRIDAY_TAVILY_API_KEY=
FRIDAY_SERPER_API_KEY=

# Optional vLLM image / GPU overrides
FRIDAY_VLLM_IMAGE=vllm/vllm-openai@sha256:2238154357f576523db1df2866cbf591734d70db8f6d50b9a7897f3c60e18940
CUDA_VISIBLE_DEVICES=0
FRIDAY_QWEN_ENFORCE_EAGER=
FRIDAY_QWEN_EXTRA_ARGS=

# Independent semantic supervisor product policy on the accepted GPT-OSS
# profile. Unknown values fail closed to off. Promotion stays independently
# disabled unless immutable source/evidence/registry bindings are supplied.
# It never grants tools, effects or publication. Keep this lexical block at EOF:
# an immutable secondary rollout removes the placeholders above and appends its
# accepted canonical secondary block after these defaults.
FRIDAY_SEMANTIC_SUPERVISOR_MAX_REVIEW_ROUNDS=1
FRIDAY_SEMANTIC_SUPERVISOR_MAX_STEPS=6
FRIDAY_SEMANTIC_SUPERVISOR_MODE=off
FRIDAY_SEMANTIC_SUPERVISOR_PROMOTION_CANARY_ACTOR_BINDINGS=
FRIDAY_SEMANTIC_SUPERVISOR_PROMOTION_ENABLED=0
FRIDAY_SEMANTIC_SUPERVISOR_PROMOTION_EVIDENCE_FILE=
FRIDAY_SEMANTIC_SUPERVISOR_PROMOTION_EVIDENCE_SHA256=
FRIDAY_SEMANTIC_SUPERVISOR_PROMOTION_LATENCY_BUDGET_FILE=
FRIDAY_SEMANTIC_SUPERVISOR_PROMOTION_LATENCY_BUDGET_SHA256=
FRIDAY_SEMANTIC_SUPERVISOR_PROMOTION_REGISTRY_BINDING_SHA256=
FRIDAY_SEMANTIC_SUPERVISOR_PROMOTION_SOURCE_REVISION_SHA256=
FRIDAY_SEMANTIC_SUPERVISOR_TASKS=
FRIDAY_SEMANTIC_SUPERVISOR_TIMEOUT_SEC=12
