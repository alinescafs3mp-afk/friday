# Copy to .env.local for direct Python launch, or to .env for Docker Compose.
# `jericho init` generates strong API and bridge secrets automatically.
JERICHO_HOME=D:\jericho
JERICHO_HOST_HOME=D:/jericho
JERICHO_PROFILE=qwen36-vl
JERICHO_MODEL_ROOT=D:\jericho\models

# `jericho up` copy-truncates a child log past this size, keeping N generations.
# The bridge polls the backend every 15s and each poll costs an access-log line,
# so an unrotated backend.log grows by tens of megabytes a day. 0 = never rotate.
JERICHO_LOG_MAX_BYTES=16777216
JERICHO_LOG_BACKUPS=3

# Local OpenAI-compatible vLLM endpoint
JERICHO_LLM_BASE_URL=http://127.0.0.1:8001/v1
# Container-to-container endpoint used by Docker Compose.
JERICHO_DOCKER_LLM_BASE_URL=http://dispatcher:8001/v1
JERICHO_LLM_MODEL=dispatcher
JERICHO_LLM_ENABLED=1
JERICHO_LLM_TIMEOUT_SEC=240
JERICHO_LLM_MAX_TOKENS=2048
JERICHO_VERIFY_ANSWERS=1
# Turning this on WITHOUT a model name below disables dense recall entirely;
# startup validation refuses that combination rather than reporting it as working.
JERICHO_EMBEDDINGS_ENABLED=0
JERICHO_EMBEDDINGS_BASE_URL=http://127.0.0.1:8001/v1
JERICHO_DOCKER_EMBEDDINGS_BASE_URL=http://dispatcher:8001/v1
JERICHO_EMBEDDINGS_MODEL=
# Passage-level recall for long objects (0 = off, pre-0.41 behaviour).
JERICHO_EMBEDDINGS_CHUNK_CHARS=1200
JERICHO_EMBEDDINGS_CHUNK_OVERLAP_CHARS=200
# Ceiling on the lexical recall pool per search. Beyond it the fuzzy channel sees
# only the most important/recent slice, and the answer reports
# `strategy.lexical_pool_capped` with the real corpus size.
JERICHO_RETRIEVAL_POOL_MAX=400
# Cosine below which a dense score is not evidence (the `insufficient_evidence`
# filter). This number belongs to the embedding MODEL: measured on
# qwen3-embedding-0.6b, unrelated query/document pairs peak at 0.39 and genuine
# matches start at 0.42. Re-measure when you change models.
JERICHO_RETRIEVAL_DENSE_EVIDENCE_MIN=0.35

# How many verified backups to keep locally. The schedule adds a full copy of the
# database every 24 hours; without a ceiling the disk fills and takes the live
# instance with it. Pruning runs after mirroring. 0 = keep everything.
JERICHO_BACKUP_KEEP=14

# API and Admin UI
JERICHO_API_HOST=127.0.0.1
JERICHO_API_BIND_ADDRESS=127.0.0.1
JERICHO_API_PORT=8000
JERICHO_API_TOKEN=replace-with-at-least-32-random-characters
JERICHO_API_REQUIRE_TOKEN_ON_LOOPBACK=1
JERICHO_API_USER_RATE_LIMIT_PER_MINUTE=240
JERICHO_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
JERICHO_TRUST_PROXY_HEADERS=0
# Required only when proxy headers are enabled; list the immediate trusted proxy hops.
JERICHO_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128

# Telegram bridge
JERICHO_TELEGRAM_BOT_TOKEN=
JERICHO_TELEGRAM_BRIDGE_SECRET=replace-with-a-different-32-character-random-secret
JERICHO_TELEGRAM_REALM_ID=telegram
# Deny-by-default: the bot ignores every chat until an allowlist or owner chat
# is set. The effective allowlist is the union of the two lists below.
#
# At least one PRIVATE chat (a positive id) must be present. Group ids are
# negative, and the bridge signs its own service calls as a user — with only
# groups allowlisted it has nobody to sign as, and proactive delivery stops. The
# bridge says so in the log rather than going quiet.
JERICHO_TELEGRAM_ALLOWED_CHAT_IDS=
JERICHO_TELEGRAM_OWNER_CHAT_IDS=
# Proxy for reaching api.telegram.org, e.g. http://127.0.0.1:10808. Set this where
# Telegram needs a tunnel: the bridge then asks for the tunnel by name instead of
# depending on one that rewrites the host's routing table. Applies to Telegram only —
# the bridge always reaches its own backend directly. http:// or https:// only; SOCKS
# would need httpx's optional socksio package, and a mixed proxy accepts HTTP CONNECT
# on the same port anyway.
JERICHO_TELEGRAM_PROXY=
JERICHO_TELEGRAM_SIGNATURE_MAX_AGE_SEC=90
JERICHO_TELEGRAM_USER_RATE_LIMIT_PER_MINUTE=30
JERICHO_TELEGRAM_GLOBAL_RATE_LIMIT_PER_MINUTE=1200

# Local workers and safety limits
JERICHO_WORKERS_ENABLED=1
JERICHO_AUTONOMY_ENABLED=1
JERICHO_OPERATOR_FULL_AUTONOMY=0
JERICHO_COGNITION_ENABLED=1
JERICHO_COGNITION_INTERVAL_SEC=300
JERICHO_COGNITION_MAX_TOKENS=512
JERICHO_EXECUTIVE_MAX_ACTIVE_MISSIONS=8
JERICHO_EXECUTIVE_MAX_TASKS_PER_MISSION=12
JERICHO_EXECUTIVE_TASK_TOOL_BUDGET=6
JERICHO_EXECUTIVE_TICK_INTERVAL_SEC=15
JERICHO_CODE_EXECUTION_ENABLED=0
JERICHO_CODE_EXECUTION_TIMEOUT_SEC=15
JERICHO_CODE_EXECUTION_MAX_OUTPUT_BYTES=65536
JERICHO_WEB_ALLOW_PRIVATE_NETWORKS=0
JERICHO_WEB_MAX_RESPONSE_BYTES=5242880
JERICHO_MAX_UPLOAD_BYTES=52428800
JERICHO_MAX_EXTRACTED_TEXT_CHARS=2000000
JERICHO_MAX_ARCHIVE_ENTRIES=500
JERICHO_MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000

# Optional public-search providers
JERICHO_BRAVE_SEARCH_API_KEY=
JERICHO_TAVILY_API_KEY=
JERICHO_SERPER_API_KEY=

# Optional vLLM image / GPU overrides
JERICHO_VLLM_IMAGE=jericho/vllm-openai:v0.25.1-asyncio-e4f88a8
CUDA_VISIBLE_DEVICES=0
JERICHO_QWEN_QUANT_ARGS=
JERICHO_QWEN_ENFORCE_EAGER=
JERICHO_QWEN_EXTRA_ARGS=
