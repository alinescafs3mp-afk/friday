# Copy to .env.local for direct Python launch, or to .env for Docker Compose.
# `jericho init` generates strong API and bridge secrets automatically.
FRIDAY_HOME=D:\jericho
FRIDAY_HOST_HOME=D:/jericho
FRIDAY_PROFILE=qwen36-vl
FRIDAY_MODEL_ROOT=D:\jericho\models

# `jericho up` copy-truncates a child log past this size, keeping N generations.
# The bridge polls the backend every 15s and each poll costs an access-log line,
# so an unrotated backend.log grows by tens of megabytes a day. 0 = never rotate.
FRIDAY_LOG_MAX_BYTES=16777216
FRIDAY_LOG_BACKUPS=3

# Local OpenAI-compatible vLLM endpoint
FRIDAY_LLM_BASE_URL=http://127.0.0.1:8001/v1
# Container-to-container endpoint used by Docker Compose.
FRIDAY_DOCKER_LLM_BASE_URL=http://dispatcher:8001/v1
FRIDAY_LLM_MODEL=dispatcher
FRIDAY_LLM_ENABLED=1
FRIDAY_LLM_TIMEOUT_SEC=240
FRIDAY_LLM_MAX_TOKENS=2048
FRIDAY_VERIFY_ANSWERS=1
# Turning this on WITHOUT a model name below disables dense recall entirely;
# startup validation refuses that combination rather than reporting it as working.
FRIDAY_EMBEDDINGS_ENABLED=0
FRIDAY_EMBEDDINGS_BASE_URL=http://127.0.0.1:8001/v1
FRIDAY_DOCKER_EMBEDDINGS_BASE_URL=http://dispatcher:8001/v1
FRIDAY_EMBEDDINGS_MODEL=
# Passage-level recall for long objects (0 = off, pre-0.41 behaviour).
FRIDAY_EMBEDDINGS_CHUNK_CHARS=1200
FRIDAY_EMBEDDINGS_CHUNK_OVERLAP_CHARS=200
# Ceiling on the lexical recall pool per search. Beyond it the fuzzy channel sees
# only the most important/recent slice, and the answer reports
# `strategy.lexical_pool_capped` with the real corpus size.
FRIDAY_RETRIEVAL_POOL_MAX=400
# Cosine below which a dense score is not evidence (the `insufficient_evidence`
# filter). This number belongs to the embedding MODEL: measured on
# qwen3-embedding-0.6b, unrelated query/document pairs peak at 0.39 and genuine
# matches start at 0.42. Re-measure when you change models.
FRIDAY_RETRIEVAL_DENSE_EVIDENCE_MIN=0.35

# How many verified backups to keep locally. The schedule adds a full copy of the
# database every 24 hours; without a ceiling the disk fills and takes the live
# instance with it. Pruning runs after mirroring. 0 = keep everything.
FRIDAY_BACKUP_KEEP=14

# API and Admin UI
FRIDAY_API_HOST=127.0.0.1
FRIDAY_API_BIND_ADDRESS=127.0.0.1
FRIDAY_API_PORT=8000
FRIDAY_API_TOKEN=replace-with-at-least-32-random-characters
FRIDAY_API_REQUIRE_TOKEN_ON_LOOPBACK=1
FRIDAY_API_USER_RATE_LIMIT_PER_MINUTE=240
# Native TLS for a direct/systemd installation: set both server paths or neither.
# Base Compose intentionally overrides these to empty and expects an external TLS
# reverse proxy, so its Telegram container never receives the private key.
# Bridge and diagnostics add only the public CA/certificate to their verified
# default trust stores; the private key never belongs in a client trust store.
FRIDAY_SSL_CERTFILE=
FRIDAY_SSL_KEYFILE=
FRIDAY_BACKEND_CA_FILE=
# Empty derives exact loopback origins using the configured HTTP/HTTPS scheme and
# API port. For LAN Admin UI, list every exact browser-facing HTTPS origin.
FRIDAY_CORS_ORIGINS=
FRIDAY_TRUST_PROXY_HEADERS=0
# Required only when proxy headers are enabled; list the immediate trusted proxy hops.
FRIDAY_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128

# Telegram bridge
FRIDAY_TELEGRAM_BOT_TOKEN=
FRIDAY_TELEGRAM_BRIDGE_SECRET=replace-with-a-different-32-character-random-secret
FRIDAY_TELEGRAM_REALM_ID=telegram
# Deny-by-default: the bot ignores every chat until an allowlist or owner chat
# is set. The effective allowlist is the union of the two lists below.
#
# At least one PRIVATE chat (a positive id) must be present. Group ids are
# negative, and the bridge signs its own service calls as a user — with only
# groups allowlisted it has nobody to sign as, and proactive delivery stops. The
# bridge says so in the log rather than going quiet.
FRIDAY_TELEGRAM_ALLOWED_CHAT_IDS=
FRIDAY_TELEGRAM_OWNER_CHAT_IDS=
# Proxy for reaching api.telegram.org, e.g. http://127.0.0.1:10808. Set this where
# Telegram needs a tunnel: the bridge then asks for the tunnel by name instead of
# depending on one that rewrites the host's routing table. Applies to Telegram only —
# the bridge always reaches its own backend directly. http:// or https:// only; SOCKS
# would need httpx's optional socksio package, and a mixed proxy accepts HTTP CONNECT
# on the same port anyway.
FRIDAY_TELEGRAM_PROXY=
FRIDAY_TELEGRAM_SIGNATURE_MAX_AGE_SEC=90
FRIDAY_TELEGRAM_USER_RATE_LIMIT_PER_MINUTE=30
FRIDAY_TELEGRAM_GLOBAL_RATE_LIMIT_PER_MINUTE=1200

# Local workers and safety limits
FRIDAY_WORKERS_ENABLED=1
FRIDAY_AUTONOMY_ENABLED=1
FRIDAY_OPERATOR_FULL_AUTONOMY=0
FRIDAY_COGNITION_ENABLED=1
FRIDAY_COGNITION_INTERVAL_SEC=300
FRIDAY_COGNITION_MAX_TOKENS=512
FRIDAY_EXECUTIVE_MAX_ACTIVE_MISSIONS=8
FRIDAY_EXECUTIVE_MAX_TASKS_PER_MISSION=12
FRIDAY_EXECUTIVE_TASK_TOOL_BUDGET=6
FRIDAY_EXECUTIVE_TICK_INTERVAL_SEC=15
FRIDAY_CODE_EXECUTION_ENABLED=0
FRIDAY_CODE_EXECUTION_TIMEOUT_SEC=15
FRIDAY_CODE_EXECUTION_MAX_OUTPUT_BYTES=65536
FRIDAY_WEB_ALLOW_PRIVATE_NETWORKS=0
FRIDAY_WEB_MAX_RESPONSE_BYTES=5242880
FRIDAY_MAX_UPLOAD_BYTES=52428800
FRIDAY_MAX_EXTRACTED_TEXT_CHARS=2000000
# Сколько секунд разбирать PDF, после чего вернуть прочитанное с пометкой
# «неполно». Одна ручка на приём файла и на /api/ingest/url. Замерено: файл в
# 41 КБ с дорогими страницами занимал поток на 35 с без этого срока.
FRIDAY_PDF_PARSE_BUDGET_SEC=8.0
FRIDAY_MAX_ARCHIVE_ENTRIES=500
FRIDAY_MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000

# Что попадает в Inbox, прежде чем стать каноническим знанием.
#   unless_explicit — безопасное умолчание: прямо продвигается только явное
#                     сохранение (/note, «запомни»); всё остальное, включая файлы,
#                     ждёт человека
#   assessed        — явный режим совместимости: `promote` канонизируется сразу
#   always          — не продвигается ничто
# Массовый импорт, /api/ingest/url и импортёр ждут решения при любой политике.
FRIDAY_INGESTION_REVIEW_POLICY=unless_explicit

# Optional public-search providers
FRIDAY_BRAVE_SEARCH_API_KEY=
FRIDAY_TAVILY_API_KEY=
FRIDAY_SERPER_API_KEY=

# Optional vLLM image / GPU overrides
FRIDAY_VLLM_IMAGE=jericho/vllm-openai:v0.25.1-asyncio-e4f88a8
CUDA_VISIBLE_DEVICES=0
FRIDAY_QWEN_QUANT_ARGS=
FRIDAY_QWEN_ENFORCE_EAGER=
FRIDAY_QWEN_EXTRA_ARGS=
