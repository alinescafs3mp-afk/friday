    {"id": "CAP-MIXED-JOURNEY", "promise": "File+archive+web mixed journeys", "risk": "high", "obligation": "required"},
    {"id": "CAP-ENGINEER", "promise": "Owner-only autonomous Engineer Mode", "risk": "critical", "obligation": "optional_when_enabled"},
    {"id": "CAP-CODING", "promise": "Coding Mode inspect/plan/build/test; execute fail-closed", "risk": "critical", "obligation": "optional_when_enabled"},
    {"id": "CAP-HOST", "promise": "Host Capability Plane default-off", "risk": "critical", "obligation": "optional_when_enabled"},
    {"id": "CAP-OBSIDIAN", "promise": "Opt-in Obsidian/Syncthing; physical Android beta", "risk": "medium", "obligation": "beta"},
    {"id": "CAP-PRIMARY-ONLY", "promise": "Primary-only path when secondary is absent", "risk": "high", "obligation": "required"},
