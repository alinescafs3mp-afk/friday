    {"id": "CAP-DOCUMENT-OUTPUT", "promise": "Generated downloadable artifact exists and opens", "risk": "high", "obligation": "required"},
    {"id": "CAP-APPROVALS-MISSIONS", "promise": "Approvals and background missions", "risk": "medium", "obligation": "required"},
    {"id": "CAP-CLI-OPS", "promise": "Operator CLI for backup, doctor, tokens", "risk": "medium", "obligation": "required"},
    {"id": "CAP-COMPANION-PLUGIN", "promise": "Obsidian companion plugin", "risk": "low", "obligation": "out_of_scope"},
    {"id": "CAP-PANDORA-DELETION", "promise": "P0H bounded deletion apply", "risk": "critical", "obligation": "out_of_scope"},
    {"id": "CAP-GEMINI-PARITY", "promise": "Parity with Gemini", "risk": "low", "obligation": "out_of_scope"},
