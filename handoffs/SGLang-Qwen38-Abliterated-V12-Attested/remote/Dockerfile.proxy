      com.friday.base-image-id="sha256:dc73b49f5124cf2ee538dfbdfbd121f0b4ccdcb20fea30f3a81bd477c02e2bb5" \
      com.friday.profile-id="qwen38-27b-nvfp4-sglang:dispatcher:v12.15" \
