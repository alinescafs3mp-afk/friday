      org.opencontainers.image.base.digest="sha256:506525a5907ea22c9d445afb7c03603959b912de034d86915cf17da814f1a124" \
      com.friday.base-image-id="sha256:317b75ce527f3b6ee482e9437c753e98f4df6e6b17a335f8681af5d86a8a9de8" \
      com.friday.profile-id="qwen38-27b-nvfp4-sglang:dispatcher:v12.14" \
