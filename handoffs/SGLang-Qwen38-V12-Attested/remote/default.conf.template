server {
    listen 8080;
    server_name _;
    server_tokens off;

    client_max_body_size 64m;
    proxy_connect_timeout 10s;
    proxy_send_timeout 900s;
    proxy_read_timeout 900s;

    location = /health {
        if ($request_method != GET) { return 405; }
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_pass http://${SGLANG_UPSTREAM}:30000/health;
    }

    location = /v1/chat/completions {
        if ($request_method != POST) { return 405; }
        if ($http_authorization != "Bearer ${JARVIS_LLM_API_KEY}") { return 401; }
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://${SGLANG_UPSTREAM}:30000/v1/chat/completions;
    }

    location = /v1/models {
        if ($request_method != GET) { return 405; }
        if ($http_authorization != "Bearer ${JARVIS_LLM_API_KEY}") { return 401; }
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_pass http://${SGLANG_UPSTREAM}:30000/v1/models;
    }

    location = /metrics {
        if ($request_method != GET) { return 405; }
        if ($http_authorization != "Bearer ${JARVIS_LLM_API_KEY}") { return 401; }
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_pass http://${SGLANG_UPSTREAM}:30000/metrics;
    }

    location = /server_info {
        if ($request_method != GET) { return 405; }
        if ($http_authorization != "Bearer ${JARVIS_LLM_API_KEY}") { return 401; }
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_pass http://${SGLANG_UPSTREAM}:30000/server_info;
    }

    location = /_friday/v1/deployment-witness {
        if ($request_method != GET) { return 405; }
        if ($http_authorization != "Bearer ${JARVIS_LLM_API_KEY}") { return 401; }
        alias /run/friday-witness/deployment-witness.v1.json;
        default_type application/json;
        open_file_cache off;
        add_header Cache-Control "no-store" always;
        add_header Pragma "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        return 404;
    }
}
