                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "relative_path",
              "publisher_raw_sha256",
              "metadata_content_sha256"
            ]
          },
          "minItems": 0,
          "maxItems": 202
        },
        "grant_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "held_root": {
          "type": "string"
        },
        "index_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "index_size": {
          "type": "integer"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "type": "string",
              "const": "friday.astra.e4.lab821.scan-result.v1"
            },
            "expected_output_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "schema",
            "expected_output_sha256"
          ]
