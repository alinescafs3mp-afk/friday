{
  "$id": "friday.astra.e4.lab821.scan-admission.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assert_document": {
      "type": "string"
    },
    "context": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": [
            "boolean",
            "null",
            "string"
          ]
        },
        "bill_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "codecs": {
          "type": "object"
        },
        "content_pins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "relative_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65535,
                "pattern": "[^\\x00]+"
              },
              "publisher_raw_sha256": {
                "type": [
                  "null",
                  "string"
                ],
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              },
              "metadata_content_sha256": {
                "type": [
                  "null",
                  "string"
