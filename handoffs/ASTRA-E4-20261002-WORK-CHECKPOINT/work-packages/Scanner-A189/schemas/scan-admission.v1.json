    "future_plan_sha256": {
      "type": "string"
    },
    "held_role": {
      "type": "string"
    },
    "index_role": {
      "type": "string"
    },
    "oracle_id": {
      "type": "string"
    },
    "publisher_evidence": {
      "type": [
        "null",
        "object"
      ]
    },
    "resources": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "friday.astra.e4.lab818.scan-resource.v1"
        }
