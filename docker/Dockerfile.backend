# Matches the interpreter the test suite runs on. A container one or two minor
# versions behind means the code shipped to production is not the code that was
# verified — the whole point of pinning the runtime.
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system jericho \
    && useradd --system --gid jericho --home-dir /home/jericho --create-home jericho

WORKDIR /build
COPY pyproject.toml README.md requirements.lock ./
COPY jericho/ ./jericho/
# Constrained to the exact transitive versions the suite was green on, so a rebuild
# months later cannot quietly resolve a different dependency tree. Every compiled
# dependency has a cp314 manylinux wheel, so no build toolchain is needed here.
RUN python -m pip install --upgrade pip \
    && python -m pip install . --constraint requirements.lock

COPY docker/entrypoint.sh /usr/local/bin/jericho-entrypoint
RUN chmod 0755 /usr/local/bin/jericho-entrypoint \
    && mkdir -p /runtime/data /runtime/cache /runtime/logs /runtime/models \
    && chown -R jericho:jericho /runtime /home/jericho

WORKDIR /runtime
USER jericho
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/jericho-entrypoint"]
CMD ["jericho", "server"]
