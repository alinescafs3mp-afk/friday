[Unit]
Description=Friday narrow privileged APT package broker
Documentation=file:///usr/local/share/doc/friday-host-control/README.md
Requires=friday-package-broker.socket
After=friday-package-broker.socket network-online.target
ConditionPathExists=/etc/friday-host-control/backend-approval-signing.pub

[Service]
Type=simple
User=root
Group=root
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/friday-host-control/release.env
Environment=HOME=/var/lib/friday-package-broker
Environment=DEBIAN_FRONTEND=noninteractive
UnsetEnvironment=FRIDAY_API_TOKEN FRIDAY_TELEGRAM_BOT_TOKEN FRIDAY_TELEGRAM_BRIDGE_SECRET FRIDAY_LLM_API_KEY FRIDAY_SECONDARY_LLM_API_KEY FRIDAY_EMBEDDINGS_API_KEY FRIDAY_RERANK_API_KEY FRIDAY_BRAVE_SEARCH_API_KEY FRIDAY_TAVILY_API_KEY FRIDAY_SERPER_API_KEY FRIDAY_YANDEX_SEARCH_API_KEY FRIDAY_BACKUP_ENCRYPTION_KEY_FILE FRIDAY_SSL_KEYFILE
ExecStart=/opt/friday-host-control/current/bin/friday-package-broker --systemd-socket --socket /run/friday-package-broker/broker.sock --policy /etc/friday-host-control/broker-policy.toml --key-file /etc/friday-host-control/broker.key --signing-key-file /etc/friday-host-control/broker-signing.key --approval-verification-public-key-file /etc/friday-host-control/backend-approval-signing.pub --state-dir /var/lib/friday-package-broker --build-id ${FRIDAY_HOST_CONTROL_BUILD_ID}
TimeoutStartSec=900s
TimeoutStopSec=900s
KillMode=control-group
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=friday-package-broker
UMask=0077
StateDirectory=friday-package-broker
StateDirectoryMode=0700

# APT must mutate package-managed system paths, so ProtectSystem cannot be used
# here honestly.  The separate broker has no generic process API and the rest of
# the host is reduced as far as the package-manager transaction permits.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID CAP_SETGID CAP_SETUID CAP_SYS_CHROOT CAP_MKNOD CAP_SETFCAP
LimitNOFILE=4096
TasksMax=256
MemoryMax=1G

# Socket activation owns the lifecycle; there is deliberately no [Install]
# target for the privileged service itself.
