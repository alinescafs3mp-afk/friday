[Unit]
Description=Friday unprivileged host capability agent
Documentation=file:///usr/local/share/doc/friday-host-control/README.md
ConditionPathExists=%h/.config/friday-host-agent/agent.key
ConditionPathExists=/etc/friday-host-control/broker.key
ConditionPathExists=/etc/friday-host-control/broker-signing.pub
ConditionPathExists=/etc/friday-host-control/host-agent-policy.toml
ConditionPathExists=/etc/friday-host-control/backend-approval-signing.pub

[Service]
Type=simple
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PATH=/usr/bin:/bin
EnvironmentFile=/etc/friday-host-control/release.env
EnvironmentFile=/etc/friday-host-control/host-agent.env
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS
UnsetEnvironment=FRIDAY_API_TOKEN FRIDAY_TELEGRAM_BOT_TOKEN FRIDAY_TELEGRAM_BRIDGE_SECRET FRIDAY_LLM_API_KEY FRIDAY_BRAVE_SEARCH_API_KEY FRIDAY_TAVILY_API_KEY FRIDAY_SERPER_API_KEY
ExecStart=/usr/bin/env --ignore-environment LANG=C.UTF-8 LC_ALL=C.UTF-8 PATH=/usr/bin:/bin HOME=%h XDG_RUNTIME_DIR=%t PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 DISPLAY=${DISPLAY} WAYLAND_DISPLAY=${WAYLAND_DISPLAY} XAUTHORITY=${XAUTHORITY} XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP} DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS} /opt/friday-host-control/current/bin/friday-host-agent --socket ${FRIDAY_HOST_AGENT_SOCKET} --key-file %h/.config/friday-host-agent/agent.key --state-dir %S/friday-host-agent --job-root ${FRIDAY_HOST_JOB_ROOT} --network-policy /etc/friday-host-control/host-agent-policy.toml --network-approval-public-key-file /etc/friday-host-control/backend-approval-signing.pub --agent-id ${FRIDAY_HOST_AGENT_ID} --allowed-peer-uid ${FRIDAY_HOST_AGENT_ALLOWED_PEER_UID} --build-id ${FRIDAY_HOST_CONTROL_BUILD_ID} --max-concurrency ${FRIDAY_HOST_AGENT_MAX_CONCURRENCY} --broker-socket /run/friday-package-broker/broker.sock --broker-key-file /etc/friday-host-control/broker.key --broker-signing-public-key-file /etc/friday-host-control/broker-signing.pub
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillMode=control-group
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=friday-host-agent
StateDirectory=friday-host-agent
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/etc/friday-host-control/backend-approval-signing.key
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitNOFILE=1024
TasksMax=64
MemoryMax=512M

[Install]
WantedBy=default.target
