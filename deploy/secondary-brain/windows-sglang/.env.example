# Copy to .env only after live discovery. Never commit .env.
# Mutable tags are rejected by the operator workflow; use an exact local digest.
FRIDAY_SECONDARY_SGLANG_IMAGE=REPLACE_WITH_lmsysorg_sglang_AT_sha256_DIGEST
FRIDAY_SECONDARY_MODEL_VOLUME=REPLACE_WITH_SEALED_MODEL_VOLUME

# Baseline discovery values, not certified capacity claims.
FRIDAY_SECONDARY_CONTEXT_TOKENS=4096
FRIDAY_SECONDARY_MAX_TOTAL_TOKENS=4096
FRIDAY_SECONDARY_MEM_FRACTION_STATIC=0.86

# HTTPS gateway only. Plain SGLang TCP 30000 is never published to LAN.
# Must be the laptop's concrete LAN address; never use 0.0.0.0 here.
FRIDAY_SECONDARY_BIND_ADDRESS=192.168.1.35
